---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Contacter l'équipe de Boussole Animale.">
  <div class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="font-display text-3xl font-semibold text-encre-900">Contact</h1>
    <p class="mt-4 text-encre-700">
      Une question, une correction à signaler sur une fiche, une suggestion de race à ajouter ?
      Écrivez-nous à <a href="mailto:contact@boussoleanimale.fr" class="text-terracotta-600 hover:underline">contact@boussoleanimale.fr</a>.
    </p>
  </div>
</Layout>
