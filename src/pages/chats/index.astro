---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HubRaces, { type RaceItem } from '../../components/HubRaces.tsx';

const races = (await getCollection('chats')).sort((a, b) => a.data.nom.localeCompare(b.data.nom));

const racesItems: RaceItem[] = await Promise.all(
  races.map(async (race) => {
    const image = await getImage({
      src: race.data.image,
      width: 400,
      height: 300,
      position: race.data.imagePosition ?? 'center',
      format: 'webp',
    });
    return {
      slug: race.id,
      nom: race.data.nom,
      resume: race.data.resume,
      imageSrc: image.src,
      imageWidth: image.attributes.width as number,
      imageHeight: image.attributes.height as number,
      imageAlt: race.data.imageAlt,
      niveauActivite: race.data.niveauActivite,
      adapteAppartement: race.data.adapteAppartement,
      adapteEnfants: race.data.adapteEnfants,
      aboiement: race.data.aboiement,
    };
  })
);
---

<Layout
  title="Toutes les races de chats"
  description="Fiches détaillées sur les races de chats : caractère, budget réel, santé, entretien. Guide indépendant et régulièrement mis à jour."
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <Breadcrumbs items={[{ label: 'Accueil', href: '/' }, { label: 'Chats' }]} />

    <h1 class="font-display text-3xl font-medium text-encre-900">Races de chats</h1>
    <p class="mt-2 max-w-2xl text-encre-700">
      Des fiches complètes, rédigées et vérifiées, pour comprendre le vrai caractère, le budget réel et les besoins
      quotidiens de chaque race avant d'adopter.
    </p>

    <div class="mt-8">
      <HubRaces client:load races={racesItems} espece="chat" />
    </div>
  </div>
</Layout>
