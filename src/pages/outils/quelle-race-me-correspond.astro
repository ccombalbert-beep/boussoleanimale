---
import Layout from '../../layouts/Layout.astro';
import QuizRace from '../../components/QuizRace.tsx';

const faq = [
  {
    question: 'Comment sont calculés les résultats du quiz ?',
    reponse:
      "Chaque race gagne des points selon la correspondance entre vos réponses (logement, temps disponible, expérience, présence d'enfants, tolérance à l'entretien du poil) et son profil réel. La présence de jeunes enfants est traitée en critère quasi-éliminatoire pour les races jugées peu adaptées, pas comme un simple bonus — pour ne jamais faire remonter une race à risque dans un foyer avec enfants.",
  },
  {
    question: 'Le quiz couvre-t-il toutes les races du site ?',
    reponse:
      "Non : le quiz compare actuellement 6 races soigneusement choisies pour représenter des profils très différents (du Chihuahua d'appartement au Border Collie sportif). Le site documente 14 races de chien au total — si le quiz ne trouve pas la vôtre, parcourez le hub complet des races de chien.",
  },
  {
    question: 'Que faire si aucun résultat ne me convainc vraiment ?',
    reponse:
      "Recommencez en étant plus strict sur vos réponses réelles (pas celles que vous aimeriez donner) : le quiz reflète fidèlement ce que vous répondez, pas une intuition. Si les 3 résultats vous semblent tous un peu décalés, c'est souvent le signe que votre mode de vie correspond mieux à une race hors de cette sélection de 6 — direction le hub complet.",
  },
  {
    question: 'Le quiz remplace-t-il une rencontre avec la race avant adoption ?',
    reponse:
      "Non, en aucun cas. C'est un outil de présélection basé sur des critères objectifs (logement, temps, expérience), pas un prédicteur de compatibilité individuelle — le tempérament d'un animal précis, sa lignée et son éducation comptent tout autant que sa race.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.reponse },
  })),
};
---

<Layout
  title="Quelle race de chien me correspond ?"
  description="Répondez à 5 questions simples sur votre logement, votre temps disponible et votre expérience pour découvrir les races de chiens qui vous correspondent vraiment."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <div class="mx-auto max-w-2xl px-4 py-12">
    <p class="label text-terracotta-600">Outil interactif</p>
    <h1 class="mt-2 font-display text-3xl font-medium text-encre-900">Quelle race de chien me correspond ?</h1>
    <p class="mt-3 text-encre-700">
      5 questions rapides sur votre mode de vie pour identifier les races les plus adaptées à votre situation réelle
      — pas seulement à vos goûts esthétiques.
    </p>

    <div class="mt-10 border border-sable-300 bg-sable-50 p-6 sm:p-8">
      <QuizRace client:visible />
    </div>

    <p class="mt-6 text-sm text-encre-700">
      Vous préférez comparer directement ?{' '}
      <a href="/chiens/" class="font-medium text-terracotta-600 hover:text-terracotta-500">Parcourez toutes les races de chien</a>.
    </p>

    <section class="mt-16" aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="mb-4 font-display text-2xl font-medium text-encre-900">Questions fréquentes</h2>
      <div class="divide-y divide-sable-300">
        {faq.map((item) => (
          <details class="group py-4">
            <summary class="faq-summary cursor-pointer list-none font-medium text-encre-900 group-open:text-terracotta-600">
              {item.question}
            </summary>
            <p class="mt-2 text-encre-700">{item.reponse}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
