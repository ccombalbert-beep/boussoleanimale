---
import Layout from '../../layouts/Layout.astro';
import CalculateurCout from '../../components/CalculateurCout.tsx';
---

<Layout
  title="Combien coûte un chien par mois ?"
  description="Calculez le coût mensuel réel d'un chien selon sa taille, son alimentation et vos choix (assurance, toilettage) avec ce simulateur interactif."
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-sm font-medium uppercase tracking-wide text-terracotta-600">Calculateur</p>
    <h1 class="mt-2 font-display text-3xl font-semibold text-encre-900">Combien coûte un chien par mois ?</h1>
    <p class="mt-3 text-encre-700">
      Le budget réel dépend surtout de la taille du chien et de vos choix (alimentation, assurance, toilettage).
      Ajustez les paramètres pour obtenir une estimation adaptée à votre situation.
    </p>

    <div class="mt-10 rounded-lg border border-sable-300 bg-white p-6 sm:p-8">
      <CalculateurCout client:visible />
    </div>
  </div>
</Layout>
