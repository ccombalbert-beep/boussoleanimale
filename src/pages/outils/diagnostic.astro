---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DiagnosticUnifie, { type RaceDiagnosticItem } from '../../components/DiagnosticUnifie.tsx';
import { webApplicationSchema } from '../../lib/schemas';

// Même pool que les autres outils : tout le catalogue publié, chiens et
// chats confondus, jamais une sélection figée.
const [chiens, chats] = await Promise.all([getCollection('chiens'), getCollection('chats')]);

const races: RaceDiagnosticItem[] = [
  ...chiens.map((race) => ({
    slug: race.id,
    nom: race.data.nom,
    resume: race.data.resume,
    espece: 'chien' as const,
    niveauActivite: race.data.niveauActivite,
    adapteAppartement: race.data.adapteAppartement,
    poidsMin: race.data.poids.min,
    poidsMax: race.data.poids.max,
    coutMensuelMin: race.data.budget.coutMensuelMin,
    coutMensuelMax: race.data.budget.coutMensuelMax,
    brachycephale: race.data.predispositions?.brachycephale,
    risqueArticulaireOuDorsal: race.data.predispositions?.risqueArticulaireOuDorsal,
    intoleranceSolitude: race.data.predispositions?.intoleranceSolitude,
    risqueSurpoids: race.data.predispositions?.risqueSurpoids,
    sensibiliteChaleur: race.data.predispositions?.sensibiliteChaleur,
    sensibiliteFroid: race.data.predispositions?.sensibiliteFroid,
  })),
  ...chats.map((race) => ({
    slug: race.id,
    nom: race.data.nom,
    resume: race.data.resume,
    espece: 'chat' as const,
    niveauActivite: race.data.niveauActivite,
    adapteAppartement: race.data.adapteAppartement,
    poidsMin: race.data.poids.min,
    poidsMax: race.data.poids.max,
    coutMensuelMin: race.data.budget.coutMensuelMin,
    coutMensuelMax: race.data.budget.coutMensuelMax,
    brachycephale: race.data.predispositions?.brachycephale,
    risqueArticulaireOuDorsal: race.data.predispositions?.risqueArticulaireOuDorsal,
    intoleranceSolitude: race.data.predispositions?.intoleranceSolitude,
    risqueSurpoids: race.data.predispositions?.risqueSurpoids,
    sensibiliteChaleur: race.data.predispositions?.sensibiliteChaleur,
    sensibiliteFroid: race.data.predispositions?.sensibiliteFroid,
  })),
];

const faq = [
  {
    question: 'En quoi ce diagnostic diffère-t-il du calculateur d\'espace vital ou du quiz race ?',
    reponse:
      "Ce sont trois outils complémentaires, pas redondants. L'espace vital se concentre uniquement sur le logement, le quiz race croise logement/taille/activité/expérience/budget/aboiements en restant focalisé sur le chien. Le diagnostic unifié va plus loin en ajoutant un critère que ni l'un ni l'autre ne couvre : le temps que l'animal passera seul chaque jour — et couvre chiens et chats dans un seul parcours.",
  },
  {
    question: 'Pourquoi "plus de 8h seul" n\'est-il pas éliminatoire pour un chat ?',
    reponse:
      "Parce que la tolérance à la solitude n'est pas la même selon l'espèce : un chat s'accommode structurellement mieux de longues journées seul qu'un chien, à condition d'un environnement enrichi. Ce diagnostic distingue les deux plutôt que d'appliquer la même règle partout — voir le détail par race dans les résultats.",
  },
  {
    question: 'Le critère "présence quotidienne" se base-t-il uniquement sur le niveau d\'activité ?',
    reponse:
      "Non, plus depuis un ajustement suite à un retour vétérinaire : certaines races ont une anxiété de séparation documentée sur leur fiche (Bichon Frisé, Épagneul Breton, Caniche, Dogue de Bordeaux, Siamois, Abyssin, Oriental...), un facteur distinct et parfois indépendant du niveau d'activité — un chien calme peut très mal supporter la solitude. Ce diagnostic le traite comme un motif à part, prioritaire sur la simple estimation par l'activité.",
  },
  {
    question: 'Le score global cache-t-il des détails importants ?',
    reponse:
      "Non : chaque race affiche le détail par critère (espace, budget, présence quotidienne, expérience requise), pas seulement un chiffre global. Un score correct peut cacher un seul critère problématique — c'est justement ce que le détail permet de repérer avant de se décider.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.reponse },
  })),
};

const appSchema = webApplicationSchema({
  nom: 'Diagnostic de compatibilité animal et mode de vie',
  url: 'https://boussoleanimale.fr/outils/diagnostic/',
  description:
    "Croise logement, budget, temps de présence quotidien et expérience pour identifier les races de chien ou de chat compatibles, critère par critère.",
});
---

<Layout
  title="Diagnostic complet : quelle race pour mon mode de vie ?"
  description="Croisez en une seule fois votre logement, votre budget, le temps de présence quotidien et votre expérience pour identifier les races de chien ou de chat vraiment compatibles."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(appSchema)} is:inline />
  <div class="mx-auto max-w-2xl px-4 py-12">
    <p class="label text-terracotta-600">Diagnostic complet</p>
    <h1 class="mt-2 font-display text-3xl font-medium text-encre-900">Quelle race pour votre mode de vie, vraiment ?</h1>
    <p class="mt-3 text-encre-700">
      7 questions pour croiser en une fois votre logement, votre budget, le temps de présence quotidien et votre
      expérience — sur {chiens.length} races de chien et {chats.length} races de chat, avec le détail de
      correspondance critère par critère, pas juste un score.
    </p>

    <div class="mt-10 border border-sable-300 bg-sable-50 p-6 sm:p-8">
      <DiagnosticUnifie client:visible races={races} />
    </div>

    <p class="mt-6 text-sm text-encre-700">
      Vous préférez un outil ciblé sur un seul critère ? <a href="/outils/espace-vital/" class="font-medium text-terracotta-600 hover:text-terracotta-500">Espace vital</a>, <a href="/outils/quelle-race-me-correspond/" class="font-medium text-terracotta-600 hover:text-terracotta-500">quiz race</a> ou <a href="/outils/" class="font-medium text-terracotta-600 hover:text-terracotta-500">tous les outils</a>.
    </p>

    <section class="mt-16" aria-labelledby="methode-titre">
      <h2 id="methode-titre" class="mb-4 font-display text-2xl font-medium text-encre-900">Les quatre critères du diagnostic</h2>
      <p class="text-encre-700">
        Chaque race est évaluée sur quatre critères distincts, affichés séparément dans les résultats pour qu'un bon
        score global ne masque pas un point bloquant :
      </p>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-encre-700">
        <li>
          <strong>Espace et logement.</strong> Surface, extérieur et étage face au gabarit, au niveau d'activité et aux
          prédispositions de santé de la race (même logique que le{' '}
          <a href="/outils/espace-vital/" class="font-medium text-terracotta-600 hover:text-terracotta-500">calculateur d'espace vital</a>).
        </li>
        <li>
          <strong>Budget.</strong> Le coût mensuel réel de la race, d'après sa fiche, comparé à l'enveloppe que vous
          visez. Détail des postes dans le{' '}<a href="/guides/combien-coute-un-chien-par-mois/" class="font-medium text-terracotta-600 hover:text-terracotta-500">guide sur le budget d'un chien</a>.
        </li>
        <li>
          <strong>Présence quotidienne.</strong> Le temps que l'animal passera seul. Un chat tolère mieux la solitude
          qu'un chien ; certaines races ont une anxiété de séparation documentée, un facteur distinct du niveau
          d'activité, traité en priorité.
        </li>
        <li>
          <strong>Expérience requise.</strong> Les races au niveau d'activité très élevé demandent une vraie
          expérience d'éducation et sont moins indiquées pour un premier animal.
        </li>
      </ul>
      <p class="mt-4 text-encre-700">
        Comme pour les autres outils, les résultats décrivent une race et non votre animal, et ne remplacent ni un
        vétérinaire ni un éducateur. Hésitez encore entre un chien et un chat ? Lisez{' '}
        <a href="/guides/chat-ou-chien-comment-choisir/" class="font-medium text-terracotta-600 hover:text-terracotta-500">notre guide pour choisir selon son mode de vie</a>.
      </p>
    </section>

    <section class="mt-16" aria-labelledby="faq-titre">
      <h2 id="faq-titre" class="mb-4 font-display text-2xl font-medium text-encre-900">Questions fréquentes</h2>
      <div class="divide-y divide-sable-300">
        {faq.map((item) => (
          <details class="group py-4">
            <summary class="faq-summary cursor-pointer list-none font-medium text-encre-900 group-open:text-terracotta-600">
              {item.question}
            </summary>
            <p class="mt-2 text-encre-700">{item.reponse}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
