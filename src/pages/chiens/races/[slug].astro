---
import { getCollection, render } from 'astro:content';
import RaceLayout from '../../../layouts/RaceLayout.astro';

export async function getStaticPaths() {
  const races = await getCollection('chiens');
  return races.map((race) => ({
    params: { slug: race.id },
    props: { race },
  }));
}

const { race } = Astro.props;
const { Content, headings } = await render(race);
---

<RaceLayout data={race.data} espece="chien" headings={headings} slug={race.id}>
  <Content />
</RaceLayout>
