---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RaceCard from '../../components/RaceCard.astro';

const races = (await getCollection('chiens')).sort((a, b) => a.data.nom.localeCompare(b.data.nom));
---

<Layout
  title="Toutes les races de chiens"
  description="Fiches détaillées sur les races de chiens : caractère, budget réel, santé, entretien. Guide indépendant et régulièrement mis à jour."
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="font-display text-3xl font-semibold text-encre-900">Races de chiens</h1>
    <p class="mt-2 max-w-2xl text-encre-700">
      Des fiches complètes, rédigées et vérifiées, pour comprendre le vrai caractère, le budget réel et les besoins
      quotidiens de chaque race avant d'adopter.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {races.map((race) => (
        <RaceCard
          slug={race.id}
          nom={race.data.nom}
          resume={race.data.resume}
          image={race.data.image}
          imageAlt={race.data.imageAlt}
          imagePosition={race.data.imagePosition}
          espece="chien"
        />
      ))}
    </div>

    {races.length === 0 && <p class="mt-8 text-encre-700/60">Les premières fiches arrivent très bientôt.</p>}
  </div>
</Layout>
